# По умолчанию используется data/pulse.sqlite3.
# URL_PULSE_DB=/absolute/path/to/pulse.sqlite3

# Необязательный постоянный ключ веб-доступа. По умолчанию создаётся при запуске.
# PULSE_WEB_ACCESS_KEY=your_random_base64url_access_key_here

# Необязательный путь к российскому корневому CA для профиля HTTPS проекта.
# PULSE_RUSSIAN_CA_FILE=/absolute/path/to/Russian_Trusted_Root_CA.cer

# Оставьте SMTP_HOST пустым, если нужна только лента в приложении.
SMTP_HOST=
SMTP_PORT=587
# starttls использует STARTTLS. Для TLS с начала соединения укажите tls и порт 465.
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Секреты профилей HTTP хранятся в окружении Fastify. В интерфейсе укажите имя переменной.
# PULSE_REQUEST_SECRET_API_TOKEN=
# PULSE_REQUEST_SECRET_PROXY_PASSWORD=
