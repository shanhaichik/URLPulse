{
  "name": "url-pulse",
  "version": "1.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch src/server/main.ts --dev",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:coverage:browser": "node scripts/browser-coverage.mjs",
    "test:e2e": "npm run build && playwright test",
    "desktop": "npm run build && electron .",
    "make:mac": "node packaging/release.cjs darwin && npm run build && electron-forge make --platform=darwin",
    "make:windows": "node packaging/release.cjs win32 && npm run build && electron-forge package --platform=win32 --arch=x64 && node packaging/make-windows.mjs",
    "test:desktop": "npm run build && node e2e/desktop-smoke.mjs",
    "audit:performance": "npm run build && node scripts/performance-audit.mjs",
    "audit:catalog": "npm run build && node scripts/catalog-benchmark.mjs",
    "audit:worklist": "npm run build && node scripts/worklist-benchmark.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "fastify": "^5.7.0",
    "i18next": "^27.2.9",
    "ipaddr.js": "^2.3.0",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.6.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.3",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-base": "^8.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "^9.2.0",
    "electron": "^45.3.4",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-source-maps": "5.0.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "productName": "Pulse URL",
  "description": "Мониторинг доступности URL",
  "author": "Pulse URL",
  "main": "dist/desktop/main.js",
  "config": {
    "forge": "./forge.config.cjs"
  }
}
